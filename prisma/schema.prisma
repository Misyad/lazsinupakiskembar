generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CoinBoxStatus {
  ACTIVE
  LOST
  DAMAGED
  INACTIVE
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum WithdrawalStatus {
  PENDING
  VALIDATED
  REJECTED
  VOIDED
}

enum CashTransactionType {
  INCOME
  EXPENSE
  ADJUSTMENT
}

enum CashTransactionStatus {
  PENDING
  VALIDATED
  REJECTED
  VOIDED
}

enum CashTransactionReferenceType {
  WITHDRAWAL
  EXPENSE
  ADJUSTMENT
}

enum PublicReportStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(120)
  email        String        @unique @db.VarChar(180)
  phone        String?       @db.VarChar(30)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  sessions     UserSession[]
  userRoles    UserRole[]
  withdrawals  Withdrawal[]  @relation("WithdrawalCollector")
  cashCreated  CashTransaction[] @relation("CashTransactionCreator")
  cashValidated CashTransaction[] @relation("CashTransactionValidator")
  auditLogs    AuditLog[]
  wilayahStats WilayahStatistics[]
  routeCollections RouteCollection[]
  housesOfficer House[]          @relation("HouseOfficer")
  houseLogs     HouseLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(60)
  name            String           @db.VarChar(80)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(120)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("user_sessions")
}

model Area {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  parent    Area?    @relation("AreaChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Area[]   @relation("AreaChildren")
  houses    House[]

  @@index([parentId])
  @@map("areas")
}

model House {
  id           Int                    @id @default(autoincrement())
  houseCode    String?                @unique @map("house_code") @db.VarChar(20)
  areaId       Int                    @map("area_id")
  headOfFamily String                 @map("head_of_family") @db.VarChar(140)
  spouseName   String?                @map("spouse_name") @db.VarChar(140)
  phone        String?                @db.VarChar(30)
  whatsapp     String?                @db.VarChar(30)
  email        String?                @db.VarChar(100)
  address      String                 @db.VarChar(255)
  rtRw         String                 @map("rt_rw") @db.VarChar(30)
  rt           String?                @db.VarChar(10)
  rw           String?                @db.VarChar(10)
  hamlet       String?                @db.VarChar(60)
  postalCode   String?                @map("postal_code") @db.VarChar(10)
  locationNote String?                @map("location_note") @db.VarChar(255)
  latitude     Float?                 @map("latitude")
  longitude    Float?                 @map("longitude")
  photoId      Int?                   @map("photo_id")
  status       String                 @default("belum_dipasang") @db.VarChar(30)
  officerId    Int?                   @map("officer_id")
  surveyDate   DateTime?              @map("survey_date")
  notes        String?                @db.VarChar(500)
  joinedAt     DateTime               @map("joined_at")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")
  area         Area                   @relation(fields: [areaId], references: [id])
  officer      User?                  @relation("HouseOfficer", fields: [officerId], references: [id], onDelete: SetNull)
  assignments  CoinBoxAssignment[]
  withdrawals  Withdrawal[]
  photo        MediaAsset?            @relation("HousePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  photos       HousePhoto[]
  logs         HouseLog[]

  @@index([areaId])
  @@index([rtRw])
  @@index([status])
  @@index([hamlet])
  @@index([latitude])
  @@map("houses")
}

model CoinBox {
  id             Int                    @id @default(autoincrement())
  boxNumber      String                 @unique @map("box_number") @db.VarChar(60)
  status         CoinBoxStatus          @default(ACTIVE)
  distributedAt  DateTime?              @map("distributed_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")
  assignments    CoinBoxAssignment[]
  withdrawals    Withdrawal[]

  @@index([status])
  @@map("coin_boxes")
}

model CoinBoxAssignment {
  id          Int              @id @default(autoincrement())
  coinBoxId   Int              @map("coin_box_id")
  houseId     Int              @map("house_id")
  assignedAt  DateTime         @default(now()) @map("assigned_at")
  unassignedAt DateTime?       @map("unassigned_at")
  status      AssignmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  coinBox     CoinBox          @relation(fields: [coinBoxId], references: [id])
  house       House            @relation(fields: [houseId], references: [id])

  @@index([coinBoxId])
  @@index([houseId])
  @@index([status])
  @@index([unassignedAt])
  @@map("coin_box_assignments")
}

model Withdrawal {
  id           Int              @id @default(autoincrement())
  coinBoxId    Int              @map("coin_box_id")
  houseId      Int              @map("house_id")
  collectorId  Int              @map("collector_id")
  amount       Int
  status       WithdrawalStatus @default(PENDING)
  notes        String?          @db.VarChar(500)
  collectedAt  DateTime         @map("collected_at")
  validatedAt  DateTime?        @map("validated_at")
  rejectedAt   DateTime?        @map("rejected_at")
  voidedAt      DateTime?        @map("voided_at")
  voidReason    String?          @map("void_reason") @db.VarChar(500)
  latitude     Float?           @map("latitude")
  longitude    Float?           @map("longitude")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  coinBox      CoinBox          @relation(fields: [coinBoxId], references: [id])
  house        House            @relation(fields: [houseId], references: [id])
  collector    User             @relation("WithdrawalCollector", fields: [collectorId], references: [id])
  transactions CashTransaction[]

  @@index([status])
  @@index([collectedAt])
  @@index([collectorId])
  @@index([coinBoxId])
  @@index([houseId])
  @@map("withdrawals")
}

model FinancialCategory {
  id           Int               @id @default(autoincrement())
  code         String            @unique @db.VarChar(60)
  name         String            @db.VarChar(120)
  type         CashTransactionType
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")
  transactions CashTransaction[]

  @@index([type])
  @@map("financial_categories")
}

model CashTransaction {
  id            Int                          @id @default(autoincrement())
  categoryId    Int                          @map("category_id")
  withdrawalId  Int?                         @unique @map("withdrawal_id")
  type          CashTransactionType
  status        CashTransactionStatus        @default(VALIDATED)
  referenceType CashTransactionReferenceType @default(ADJUSTMENT) @map("reference_type")
  referenceId   Int?                         @map("reference_id")
  amount        Int
  description   String                       @db.VarChar(255)
  reason        String?                      @db.VarChar(500)
  createdById   Int?                         @map("created_by_id")
  validatedById Int?                         @map("validated_by_id")
  validatedAt   DateTime?                    @map("validated_at")
  rejectedAt    DateTime?                    @map("rejected_at")
  voidedAt      DateTime?                    @map("voided_at")
  transactionAt DateTime           @map("transaction_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  category     FinancialCategory   @relation(fields: [categoryId], references: [id])
  withdrawal   Withdrawal?         @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("CashTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  validatedBy  User?               @relation("CashTransactionValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([validatedAt])
  @@index([transactionAt])
  @@index([categoryId])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([validatedById])
  @@map("cash_transactions")
}

model PublicReport {
  id          Int                @id @default(autoincrement())
  period      String             @unique @db.VarChar(40)
  title       String             @db.VarChar(160)
  summary     String             @db.Text
  status      PublicReportStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  attachments Attachment[]

  @@index([status])
  @@map("public_reports")
}

model Attachment {
  id             Int           @id @default(autoincrement())
  publicReportId Int?          @map("public_report_id")
  fileName       String        @map("file_name") @db.VarChar(180)
  fileUrl        String        @map("file_url") @db.VarChar(500)
  mimeType       String        @map("mime_type") @db.VarChar(120)
  sizeBytes      Int           @map("size_bytes")
  createdAt      DateTime      @default(now()) @map("created_at")
  publicReport   PublicReport? @relation(fields: [publicReportId], references: [id], onDelete: SetNull)

  @@index([publicReportId])
  @@map("attachments")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  ipAddress  String?  @map("ip_address") @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Program {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(160)
  amount      Int      @default(0)
  status      String   @default("Berjalan") @db.VarChar(40)
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([active])
  @@map("programs")
}

model Documentation {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(160)
  description String   @db.VarChar(255)
  accent      String   @default("emerald") @db.VarChar(20)
  imageId     Int?     @map("image_id")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  image       MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([active])
  @@map("documentation")
}

model MediaAsset {
  id            Int             @id @default(autoincrement())
  mimeType      String          @map("mime_type") @db.VarChar(120)
  sizeBytes     Int             @map("size_bytes")
  data          Bytes
  createdAt     DateTime        @default(now()) @map("created_at")
  documentation Documentation[]
  housePhotos   House[]         @relation("HousePhoto")

  @@map("media_assets")
}

model WilayahStatistics {
  id          Int      @id @default(autoincrement())
  dusun       String?  @db.VarChar(60)
  rw          String?  @db.VarChar(10)
  rt          String?  @db.VarChar(10)
  totalKK     Int      @default(0) @map("total_kk")
  totalKotak  Int      @default(0) @map("total_kotak")
  coverage    Float    @default(0)
  targetKotak Int      @default(0) @map("target_kotak")
  status      String   @default("perlu_penambahan") @db.VarChar(30)
  petugasId   Int?     @map("petugas_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  petugas     User?    @relation(fields: [petugasId], references: [id], onDelete: SetNull)

  @@index([dusun])
  @@index([status])
  @@map("wilayah_statistics")
}

model RouteCollection {
  id          Int      @id @default(autoincrement())
  petugasId   Int      @map("petugas_id")
  tanggal     DateTime @map("tanggal")
  dusun       String?  @db.VarChar(60)
  jarak       Float    @default(0)
  estimasi    Int      @default(0)
  status      String   @default("planned") @db.VarChar(30)
  totalKotak  Int      @default(0) @map("total_kotak")
  selesaiDi   DateTime? @map("selesai_di")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  petugas     User     @relation(fields: [petugasId], references: [id])

  @@index([petugasId])
  @@index([tanggal])
  @@index([status])
  @@map("route_collections")
}

model HousePhoto {
  id        Int      @id @default(autoincrement())
  houseId   Int      @map("house_id")
  type      String   @db.VarChar(30)
  file      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
  @@index([type])
  @@map("house_photos")
}

model HouseLog {
  id         Int      @id @default(autoincrement())
  houseId    Int      @map("house_id")
  action     String   @db.VarChar(60)
  description String? @db.VarChar(500)
  metadata   Json?    @map("metadata")
  userId     Int?     @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  house      House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([houseId])
  @@index([action])
  @@map("house_logs")
}
